{
  "name": "aethium-lang",
  "displayName": "Aethium Language Support",
  "description": "Rich language support, syntax highlighting, and snippets for Aethium (.aeth)",
  "version": "1.3.0",
  "publisher": "aethium",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aethium",
        "aliases": ["Aethium", "aethium", "aeth"],
        "extensions": [".aeth"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aethium",
        "scopeName": "source.aethium",
        "path": "./syntaxes/aethium.tmLanguage.json"
      }
    ]
  }
}
